# ==================== 默认模型选择 ====================
# 兼容旧配置：若不使用 provider / preset，也可直接填 LLM_API_* / LLM_MODEL
LLM_PROVIDER=siliconflow
LLM_MODEL_PRESET=qwen35_27b_siliconflow
LLM_API_KEY=your-api-key-here
LLM_API_BASE=https://api.siliconflow.cn/v1
LLM_MODEL=Qwen/Qwen3.5-27B
LLM_ENABLE_THINKING=true

# ==================== 调用方 / 供应商配置 ====================
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini

DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
DASHSCOPE_DEFAULT_MODEL=qwen3.5-27b

SILICONFLOW_API_BASE=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=
SILICONFLOW_DEFAULT_MODEL=Qwen/Qwen3.5-27B

GLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
GLM_API_KEY=
GLM_DEFAULT_MODEL=glm-4.5-flash

# 可选 preset：
# - openai_default
# - qwen35_27b_dashscope
# - qwen3_dashscope
# - qwen35_27b_siliconflow
# - qwen3_siliconflow
# - glm_default
# - glm4_default

# ==================== 按任务拆分的模型配置 ====================
# 不填则回落到全局 LLM_PROVIDER / LLM_MODEL_PRESET / LLM_API_*
FILTER_MODEL_PROVIDER=
FILTER_MODEL_MODEL_PRESET=
FILTER_MODEL_API_BASE=
FILTER_MODEL_API_KEY=
FILTER_MODEL_MODEL=
STAGE1_FILTER_ENABLE_THINKING=false
STAGE1_FILTER_MAX_TOKENS=10000
STAGE1_FILTER_TIMEOUT_SECONDS=15
STAGE1_FILTER_MAX_RETRIES=1

JUDGE_MODEL_PROVIDER=
JUDGE_MODEL_MODEL_PRESET=
JUDGE_MODEL_API_BASE=
JUDGE_MODEL_API_KEY=
JUDGE_MODEL_MODEL=
STAGE2_MAX_CONCURRENT_CALLS=2
STAGE2_MAX_TOKENS=10000
STAGE2_TIMEOUT_SECONDS=240
STAGE2_MAX_RETRIES=2
STAGE2_THINKING_BUDGET=32

SUGGESTION_USE_LLM_RENDERER=false
SUGGESTION_MODEL_PROVIDER=glm
SUGGESTION_MODEL_MODEL_PRESET=glm4_default
SUGGESTION_MODEL_API_BASE=
SUGGESTION_MODEL_API_KEY=
SUGGESTION_MODEL_MODEL=
SUGGESTION_MODEL_ENABLE_THINKING=false
SUGGESTION_MODEL_THINKING_BUDGET=
SUGGESTION_MODEL_MAX_TOKENS=10000
SUGGESTION_MODEL_TIMEOUT_SECONDS=45
SUGGESTION_MODEL_MAX_RETRIES=1

AUDIT_POINT_WORKBOOK_PATH=plan/smoke数据构造种子集.xlsx

# ==================== 日志与并发 ====================
LOG_LEVEL=INFO
ENABLE_TRACE_LOG=true
MAX_CONCURRENT_CALLS=8

# ==================== Benchmark 稳定模式 ====================
# 仅用于 benchmark 跑批，不影响线上审核入口
BENCHMARK_STABLE_MODE=true
BENCHMARK_MAX_CONCURRENT_CALLS=4
BENCHMARK_STAGE2_MAX_CONCURRENT_CALLS=1
BENCHMARK_FILTER_MODEL_ENABLE_THINKING=false
BENCHMARK_FILTER_MODEL_MAX_TOKENS=10000
BENCHMARK_FILTER_MODEL_TIMEOUT_SECONDS=15
BENCHMARK_FILTER_MODEL_MAX_RETRIES=1
BENCHMARK_JUDGE_MODEL_ENABLE_THINKING=true
BENCHMARK_JUDGE_MODEL_THINKING_BUDGET=32
BENCHMARK_JUDGE_MODEL_MAX_TOKENS=10000
BENCHMARK_JUDGE_MODEL_TIMEOUT_SECONDS=240
BENCHMARK_JUDGE_MODEL_MAX_RETRIES=2
BENCHMARK_SUGGESTION_USE_LLM_RENDERER=false
BENCHMARK_SUGGESTION_MODEL_ENABLE_THINKING=false
BENCHMARK_SUGGESTION_MODEL_MAX_TOKENS=10000
